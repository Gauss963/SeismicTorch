foreach(mode IN ITEMS sac mseed)
  if(mode STREQUAL "sac")
    set(input --sac "${FIXTURES}/x.sac" "${FIXTURES}/y.sac" "${FIXTURES}/z.sac")
  else()
    set(input --mseed "${FIXTURES}/steim2.mseed")
  endif()
  set(output "${WORK}/${mode}-probabilities.csv")
  execute_process(COMMAND "${PROGRAM}" ${input} --output "${output}" RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${mode} inference failed: ${error}")
  endif()
  file(STRINGS "${output}" rows)
  list(LENGTH rows count)
  list(GET rows 0 header)
  if(NOT count EQUAL 1401 OR NOT header STREQUAL "time_seconds,P,S,Noise")
    message(FATAL_ERROR "${mode}: expected header and 1400 sample rows")
  endif()
  file(SHA256 "${output}" ${mode}_hash)
endforeach()
if(NOT sac_hash STREQUAL mseed_hash)
  message(FATAL_ERROR "Equivalent SAC and miniSEED recordings produced different CSV output")
endif()
